<?xml version="1.0"?>
<ruleset name="Decent Elements">

	<description>Coding standards for the Decent Elements plugin.</description>

	<!-- What to scan. -->
	<file>decent-elements.php</file>
	<file>src</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!--
		Legacy files not yet modernized. Each entry is removed as its widget or
		extension is rewritten in Phase 3 of docs/ARCHITECTURE-AUDIT.md, so this
		list is the remaining-work tracker for coding standards.

		Do NOT add new entries. New code is expected to pass clean.
	-->
	<exclude-pattern>src/Widgets/*</exclude-pattern>
	<exclude-pattern>src/extensions/*</exclude-pattern>
	<exclude-pattern>src/Traits/*</exclude-pattern>
	<exclude-pattern>src/Widget_Manager.php</exclude-pattern>
	<exclude-pattern>src/Extension_Manager.php</exclude-pattern>
	<exclude-pattern>src/Admin/Admin_Panel_API.php</exclude-pattern>
	<exclude-pattern>src/Admin/Admin_Menu.php</exclude-pattern>
	<exclude-pattern>src/Admin/Admin_Assets.php</exclude-pattern>
	<exclude-pattern>src/Admin/Optimizer/*</exclude-pattern>

	<!-- Command line defaults. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- The WordPress standard, minus the rules we deliberately diverge from. -->
	<rule ref="WordPress">
		<!--
			Composer PSR-4 requires class-name-derived filenames, which is the
			opposite of WordPress's class-*.php convention. PSR-4 wins here
			because the autoloader depends on it.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- Security sniffs are hard failures, never warnings. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<type>error</type>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<type>error</type>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<type>error</type>
	</rule>

	<!-- Enforce the single text domain. This sniff would have caught the 662
	     wrong-domain strings fixed in Phase 0. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="decent-elements"/>
			</property>
		</properties>
	</rule>

	<!--
		The plugin namespaces its hooks with slashes (`decent_elements/modules`),
		matching Elementor's own convention (`elementor/widgets/register`) and the
		filters this plugin already shipped. WPCS prefers underscores throughout;
		consistency with the surrounding ecosystem wins here.
	-->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Enforce prefixes on anything that reaches global scope. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="decent_elements"/>
				<element value="DECENT_ELEMENTS"/>
				<element value="Decent_Elements"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported WordPress version, for deprecation sniffs. -->
	<config name="minimum_wp_version" value="5.9"/>

	<!-- PHP 8.0+ compatibility. -->
	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>

</ruleset>
