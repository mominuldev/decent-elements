{
    "name": "decent-elements/decent-elements",
    "description": "A collection of Elementor widgets and addons to enhance your website.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.0",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/generator": "^0.9.0",
        "php-stubs/wordpress-stubs": "^6.5",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Decent_Elements\\": "src/"
        },
        "exclude-from-classmap": [
            "**/node_modules/**"
        ]
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse"
        ],
        "stubs": "generate-stubs --force --out=stubs/elementor-stubs.php ../elementor/includes/base ../elementor/includes/controls ../elementor/includes/managers ../elementor/includes/widgets ../elementor/includes/elements ../elementor/includes/utils.php ../elementor/includes/plugin.php ../elementor/core/documents-manager.php ../elementor/core/base"
    },
    "scripts-descriptions": {
        "lint": "Check coding standards with PHPCS.",
        "fix": "Auto-fix coding standard violations with PHPCBF.",
        "analyse": "Run static analysis with PHPStan.",
        "check": "Run all static checks.",
        "stubs": "Regenerate Elementor stubs from the sibling elementor plugin. Run after upgrading Elementor."
    }
}
